generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BRAND
  CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// Lowercase to match the mobile app's SocialPlatform
enum Platform {
  instagram
  tiktok
  youtube
  x
  facebook
}

enum Availability {
  available
  busy
  booked
}

enum SwipeDirection {
  LIKE
  PASS
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// Mirrors CampaignStatus in the mobile app (src/types/domain.ts)
enum CampaignStatus {
  pending_agreement
  awaiting_funding
  funded
  in_progress
  submitted
  under_review
  revision_required
  approved
  payout_processing
  payout_failed
  completed
  disputed
  cancelled
  refund_processing
  refund_failed
  refunded
}

enum TransactionKind {
  FUNDING
  PAYOUT
  REFUND
}

enum TransactionStatus {
  pending
  processing
  successful
  failed
}

enum Verdict {
  PASS
  PARTIAL
  FAIL
  NEEDS_REVIEW
}

enum DisputeStatus {
  OPEN
  RESOLVED_RELEASE
  RESOLVED_REFUND
  RESOLVED_REVISION
}

enum MessageKind {
  text
  system
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  phone              String?            @unique
  passwordHash       String
  role               Role
  status             UserStatus         @default(ACTIVE)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  onboardedAt        DateTime?
  /// Creators: brands can find and invite them in Discover. Off = only they can apply.
  openToInvites      Boolean            @default(true)
  emailVerifiedAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  creatorProfile    CreatorProfile?
  brandProfile      BrandProfile?
  payoutDestination PayoutDestination?
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  pushTokens        PushToken[]
  messages          Message[]
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model OtpCode {
  id         String     @id @default(uuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  family       String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([family])
}

model CreatorProfile {
  userId             String            @id
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  avatarUrl          String?
  bio                String?
  location           String?
  category           String?
  niches             String[]
  portfolio          String[]
  priceFromKobo      Int?
  priceToKobo        Int?
  credibilityScore   Float             @default(0)
  ratingAvg          Float             @default(0)
  completedCampaigns Int               @default(0)
  availability       Availability      @default(available)
  socials            SocialAccount[]
  mlProfile          CreatorMlProfile?
}

/// Versioned recommendation features kept separate from operational profile fields.
/// Synthetic provenance is explicit; private generator truth is never stored here.
model CreatorMlProfile {
  id                     String         @id @default(uuid())
  creatorId              String         @unique
  creator                CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  namespace              String
  sourceCreatorId        String
  sourceRecordHash       String
  schemaVersion          String
  synthetic              Boolean        @default(false)
  sourceKind             String
  portfolioDescription   String?
  contentTone            String?
  contentLanguages       String[]
  audienceInterests      String[]
  creativeStyles         String[]
  productionCapabilities String[]
  typicalLeadTimeDays    Int?
  imageAssetId           String?
  displayImageOverrideUrl String?
  sourceAvailability     String?
  commercialExperience   Json?
  featureProvenance      Json?
  dataQuality            Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  audienceMarkets         CreatorAudienceMarket[]
  deliverableCapabilities CreatorDeliverableCapability[]
  commercialRates         CreatorCommercialRate[]
  evidenceEvents          DemoMlEvidenceEvent[]

  @@unique([namespace, sourceCreatorId])
  @@index([namespace, synthetic])
}

model CreatorAudienceMarket {
  id                 String           @id @default(uuid())
  creatorMlProfileId String
  creatorMlProfile   CreatorMlProfile @relation(fields: [creatorMlProfileId], references: [id], onDelete: Cascade)
  countryCode        String
  sharePercent       Decimal          @db.Decimal(5, 2)

  @@unique([creatorMlProfileId, countryCode])
  @@index([countryCode])
}

model CreatorDeliverableCapability {
  id                 String           @id @default(uuid())
  creatorMlProfileId String
  creatorMlProfile   CreatorMlProfile @relation(fields: [creatorMlProfileId], references: [id], onDelete: Cascade)
  platform           Platform
  format             String

  @@unique([creatorMlProfileId, platform, format])
  @@index([platform, format])
}

model CreatorCommercialRate {
  id                                  String           @id @default(uuid())
  creatorMlProfileId                  String
  creatorMlProfile                    CreatorMlProfile @relation(fields: [creatorMlProfileId], references: [id], onDelete: Cascade)
  platform                            Platform
  format                              String
  amount                              Decimal          @db.Decimal(18, 2)
  currency                            String
  normalizedUsd                       Decimal          @db.Decimal(18, 2)
  rateVersion                         String
  purpose                             String?
  includes                            String[]
  usageRightsMultipliers              Json
  categoryExclusivity30DaysMultiplier Decimal          @db.Decimal(8, 4)

  @@unique([creatorMlProfileId, platform, format, rateVersion])
  @@index([platform, format])
  @@index([currency, rateVersion])
}

model SocialAccount {
  id             String         @id @default(uuid())
  creatorId      String
  creator        CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  platform       Platform
  handle         String
  url            String?
  followers      Int            @default(0)
  engagementRate Float          @default(0)

  @@unique([creatorId, platform])
}

model BrandProfile {
  userId       String  @id
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  logoUrl      String?
  industry     String?
  website      String?
  contactName  String?
  location     String?
  about        String?
}

model PayoutDestination {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  updatedAt     DateTime @updatedAt
}

model Swipe {
  id        String         @id @default(uuid())
  brandId   String
  creatorId String
  /// opportunityId or "general": passing for one campaign doesn't hide the creator from the others.
  scopeKey  String         @default("general")
  direction SwipeDirection
  createdAt DateTime       @default(now())

  @@unique([brandId, creatorId, scopeKey])
}

enum OpportunityVisibility {
  PUBLIC
  PRIVATE
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// A brand's campaign brief before any agreement: what they are hiring for.
/// PUBLIC briefs are listed to creators (up to applicationLimit applications); PRIVATE are invite-only.
model Opportunity {
  id               String                @id @default(uuid())
  brandId          String
  title            String
  brief            String
  category         String
  budgetKobo       Int
  deadlineDays     Int
  deliverables     String[]
  coverImageUrl    String?
  visibility       OpportunityVisibility @default(PUBLIC)
  applicationLimit Int?
  status           OpportunityStatus     @default(PUBLISHED)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  interests        Interest[]
  mlProfile        OpportunityMlProfile?

  @@index([status, visibility])
  @@index([brandId])
}

/// Structured recommendation brief paired with an operational opportunity.
model OpportunityMlProfile {
  id                        String      @id @default(uuid())
  opportunityId             String      @unique
  opportunity               Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  namespace                 String
  sourceOpportunityId       String
  sourceRecordHash          String
  sourceBrandId             String
  schemaVersion             String
  synthetic                 Boolean     @default(false)
  industry                  String?
  product                   String?
  objective                 String?
  tone                      String?
  creativeConcept           String?
  crossCategoryRationale    String?
  callToAction              String?
  budgetAmount              Decimal     @db.Decimal(18, 2)
  budgetCurrency            String
  budgetNormalizedUsd       Decimal     @db.Decimal(18, 2)
  budgetRateVersion         String
  budgetPurpose             String?
  budgetScope               String?
  compatibleNiches          String[]
  preferredLanguages        String[]
  preferredPlatforms        String[]
  requiredLanguages         String[]
  requiredPlatforms         String[]
  keyMessages               String[]
  successMetrics            String[]
  targetAudienceDescription String?
  targetAudienceInterests   String[]
  targetAudienceMarkets     String[]
  deliverables              Json
  usageRights               Json
  timeline                  Json?
  brandSnapshot             Json?
  heldOut                   Boolean     @default(false)
  featureProvenance         Json?
  dataQuality               Json?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  evidenceEvents DemoMlEvidenceEvent[]

  @@unique([namespace, sourceOpportunityId])
  @@index([namespace, synthetic])
  @@index([sourceBrandId])
}

/// Synthetic public evidence for demonstrations only. It is intentionally
/// disconnected from Campaign, payments, disputes and operational audit logs.
model DemoMlEvidenceEvent {
  id                     String               @id @default(uuid())
  namespace              String
  schemaVersion          String
  synthetic              Boolean              @default(true)
  sourceEventId          String
  sourceRecordHash       String
  sourceJourneyId        String
  sourceContractId       String?
  previousSourceEventId  String?
  sequence               Int
  eventType              String
  occurredAt             DateTime
  details                Json
  creatorMlProfileId     String
  creatorMlProfile       CreatorMlProfile     @relation(fields: [creatorMlProfileId], references: [id], onDelete: Cascade)
  opportunityMlProfileId String
  opportunityMlProfile   OpportunityMlProfile @relation(fields: [opportunityMlProfileId], references: [id], onDelete: Cascade)
  createdAt              DateTime             @default(now())

  @@unique([namespace, sourceEventId])
  @@unique([namespace, sourceJourneyId, sequence])
  @@index([creatorMlProfileId, occurredAt])
  @@index([opportunityMlProfileId, occurredAt])
  @@index([sourceJourneyId])
}

/// Records completed write-mode imports. Dry runs never write this table.
model DemoDatasetImport {
  id                  String    @id @default(uuid())
  namespace           String
  schemaVersion       String
  generatorVersion    String
  manifestSha256      String
  datasetFingerprint  String
  databaseFingerprint String
  importerVersion     String
  status              String
  counts              Json
  conflicts           Json
  startedAt           DateTime
  completedAt         DateTime?
  createdAt           DateTime  @default(now())

  @@unique([namespace, manifestSha256, databaseFingerprint])
  @@index([namespace, status])
}

/// Auditable execution record for a reviewed production/synthetic consolidation.
model DatasetConsolidationRun {
  id                        String   @id @default(uuid())
  namespace                 String
  planHash                  String   @unique
  productionFingerprint     String
  syntheticFingerprint      String
  targetDatabaseFingerprint String
  scope                     Json
  counts                    Json
  conflicts                 Json
  backupReference           String
  status                    String
  startedAt                 DateTime
  completedAt               DateTime?
  createdAt                 DateTime @default(now())

  provenance DatasetRecordProvenance[]

  @@index([namespace, status])
}

/// Provenance for operational and explicitly approved synthetic records.
/// entityType/entityId form a controlled polymorphic reference verified by the
/// consolidation validator; no operational table depends on this metadata.
model DatasetRecordProvenance {
  id                 String                  @id @default(uuid())
  namespace          String
  entityType         String
  entityId           String
  sourceKind         String
  sourceId           String
  sourceRecordHash   String
  synthetic          Boolean
  consolidationRunId String
  consolidationRun   DatasetConsolidationRun @relation(fields: [consolidationRunId], references: [id], onDelete: Restrict)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([namespace, entityType, entityId])
  @@unique([namespace, entityType, sourceId])
  @@index([sourceKind, synthetic])
}

/// An invitation (brand → creator) or application (creator → brand), optionally for one brief.
model Interest {
  id            String         @id @default(uuid())
  brandId       String
  creatorId     String
  senderId      String
  opportunityId String?
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  /// opportunityId or "general"; lets one brand–creator pair connect over several briefs.
  scopeKey      String         @default("general")
  message       String?
  status        InterestStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([brandId, creatorId, scopeKey])
  @@index([creatorId, status])
  @@index([opportunityId, status])
}

model Match {
  id            String        @id @default(uuid())
  brandId       String
  creatorId     String
  /// The brief this connection started from (inbox groups by it).
  opportunityId String?
  createdAt     DateTime      @default(now())
  conversation  Conversation?
  campaigns     Campaign[]

  @@unique([brandId, creatorId])
}

model Conversation {
  id            String    @id @default(uuid())
  matchId       String    @unique
  brandReadAt   DateTime?
  creatorReadAt DateTime?
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages      Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id])
  kind           MessageKind  @default(text)
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Campaign {
  id                String         @id @default(uuid())
  matchId           String
  match             Match          @relation(fields: [matchId], references: [id])
  brandId           String
  creatorId         String
  title             String
  brief             String
  amountKobo        Int
  feeKobo           Int            @default(0)
  currency          String         @default("NGN")
  deadline          DateTime
  revisionLimit     Int            @default(2)
  usageRights       String?
  status            CampaignStatus @default(pending_agreement)
  termsVersion      Int            @default(1)
  brandAcceptedAt   DateTime?
  creatorAcceptedAt DateTime?
  fundedAt          DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  requirements DeliverableRequirement[]
  submissions  Submission[]
  transactions Transaction[]
  disputes     Dispute[]

  @@index([brandId, status])
  @@index([creatorId, status])
}

model DeliverableRequirement {
  id           String       @id @default(uuid())
  campaignId   String
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  position     Int
  title        String
  platform     Platform?
  hashtags     String[]
  mentions     String[]
  contentBrief String?
  submissions  Submission[]
}

model Submission {
  id            String                 @id @default(uuid())
  campaignId    String
  campaign      Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   DeliverableRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  contentUrl    String
  notes         String?
  evidenceUrls  String[]
  late          Boolean                @default(false)
  superseded    Boolean                @default(false)
  revisionNote  String?
  createdAt     DateTime               @default(now())
  verifications VerificationRun[]
}

model VerificationRun {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  verdict      Verdict?
  checks       Json?
  summary      String?
  evidence     Json?
  model        String?
  error        String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
}

model Transaction {
  id               String            @id @default(uuid())
  campaignId       String
  campaign         Campaign          @relation(fields: [campaignId], references: [id])
  kind             TransactionKind
  amountKobo       Int
  feeKobo          Int               @default(0)
  currency         String            @default("NGN")
  status           TransactionStatus @default(pending)
  idempotencyKey   String            @unique
  payazaReference  String            @unique
  /// Payaza's own id for a card checkout (its status lookup only knows this one), from the signed webhook.
  providerReference String?          @unique
  method           String?
  instructions     Json?
  providerStatus   String?
  providerResponse Json?
  failureReason    String?
  createdAt        DateTime          @default(now())
  resolvedAt       DateTime?

  @@index([campaignId, kind])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String    @unique
  type        String?
  reference   String?
  payload     Json
  signatureOk Boolean
  processedAt DateTime?
  error       String?
  receivedAt  DateTime  @default(now())
}

model Dispute {
  id         String        @id @default(uuid())
  campaignId String
  campaign   Campaign      @relation(fields: [campaignId], references: [id])
  raisedById String
  reason     String
  evidence   String[]
  status     DisputeStatus @default(OPEN)
  resolution String?
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  linkTo    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  fromState String?
  toState   String?
  reference String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

/// An Expo push token for one of the user's devices. A token belongs to whoever signed in on that device last.
model PushToken {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
